<?xml version="1.0" encoding="UTF-8"?>
<!-- Only the pure parts (without Nextcloud). The integration check runs
     nc-app/tests/integration.mjs against the Docker Nextcloud on 8081. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
	<testsuites>
		<testsuite name="unit">
			<directory>tests/Unit</directory>
		</testsuite>
	</testsuites>
	<php>
		<!-- The e-invoice tests (0.20.0) keep the serializer's metadata; the backup size test allocates 28 MB on top. -->
		<ini name="memory_limit" value="512M"/>
	</php>
</phpunit>
